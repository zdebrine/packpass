{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/controls/**",
              "ui_kits/member-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Geist))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Geist."
      },
      {
        "selector": "JSXOpeningElement[name.name='AthleteCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|photo|breed|age|stage|since|streak|stats|compact|key|ref|className|style|children)$/]",
        "message": "<AthleteCard> doesn't accept that prop. Declared props: name, photo, breed, age, stage, since, streak, stats, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|wide|block|icon|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, wide, block, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|signal|quiet|glass)$/]",
        "message": "<Button> variant must be one of 'primary' | 'signal' | 'quiet' | 'glass'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:selected|glass|icon|onClick|className|children|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: selected, glass, icon, onClick, className, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClassCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:layout|image|discipline|premium|title|partner|place|time|duration|credits|spotsLeft|onClick|key|ref|className|style|children)$/]",
        "message": "<ClassCard> doesn't accept that prop. Declared props: layout, image, discipline, premium, title, partner, place, time, duration, credits, spotsLeft, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ClassCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:tile|row)$/]",
        "message": "<ClassCard> layout must be one of 'tile' | 'row'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|label|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<PhotoTile> doesn't accept that prop. Declared props: image, label, selected, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|premium|signal|warning|glass)$/]",
        "message": "<Tag> tone must be one of 'neutral' | 'premium' | 'signal' | 'warning' | 'glass'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
