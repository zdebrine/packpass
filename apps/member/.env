# The hosted PackPass project (Supabase › packpass, us-east-1). Both values are public by design:
# the publishable key only reaches what row level security allows, and it ships inside the app.
# To run on the built-in sample data instead, create .env.local with both set to nothing:
#   EXPO_PUBLIC_SUPABASE_URL=
#   EXPO_PUBLIC_SUPABASE_KEY=
EXPO_PUBLIC_SUPABASE_URL=https://qovbpxvpnslsjzunxutk.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_5H_Gi31pbOavT-u0ZqLZ9w_tUodJy-s
# The public website: Settings › Help and sign-up link to its /terms, /privacy and /support pages.
EXPO_PUBLIC_SITE_URL=https://packpass-landing.vercel.app
# Crash reports (src/lib/monitoring.ts). Empty means off. Sentry › Project settings › Client keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=
