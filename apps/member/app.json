{
  "expo": {
    "name": "PackPass",
    "slug": "packpass-member",
    "scheme": "packpass",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.packpass.member",
      "infoPlist": {
        "NSCameraUsageDescription": "PackPass uses the camera to scan the check-in code at a partner's entrance."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.packpass.member",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fefff0"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#0e0f0e"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0e0f0e"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PackPass uses the camera to scan the check-in code at a partner's entrance.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "PackPass adds the sessions you book to your calendar.",
          "remindersPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PackPass uses your photos so you can add one of your dog to their Athlete Card.",
          "cameraPermission": "PackPass uses the camera to scan the check-in code at a partner's entrance.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PackPass uses your location to show how far each class is from you."
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
