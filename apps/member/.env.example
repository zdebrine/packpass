# .env points the app at the hosted project. Override it in .env.local (not committed):
#
# Sample data, no backend (the v1 preview with Settings › Preview states):
#   EXPO_PUBLIC_SUPABASE_URL=
#   EXPO_PUBLIC_SUPABASE_KEY=
#
# Local stack (`supabase start` prints the API URL and the publishable key):
#   EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
