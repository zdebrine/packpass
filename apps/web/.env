# The hosted PackPass project (public values, same as the apps). Override in .env.local (not committed).
VITE_SUPABASE_URL=https://qovbpxvpnslsjzunxutk.supabase.co
VITE_SUPABASE_KEY=sb_publishable_5H_Gi31pbOavT-u0ZqLZ9w_tUodJy-s
# Where Apply to partner and Partner sign in go.
VITE_DASHBOARD_URL=https://packpass-partner.vercel.app
# Shown on /privacy, /terms and /support. Set once the domain's mailbox exists.
VITE_SUPPORT_EMAIL=
# App store links. Leave empty until the app is listed; the buttons then say "coming soon".
VITE_IOS_URL=
VITE_ANDROID_URL=
# Leave unset until the app is listed: the site shows the founding-member signup instead of store buttons.
VITE_APP_LIVE=
# true: the Founding Pack signup continues to Stripe Checkout ($79/month Starter, 2 bonus credits in month one).
# Leave empty to run the free waitlist only. Stripe is in test mode, so keep this off in production until it's live.
VITE_FOUNDING_PACK_CHECKOUT=
# Sanity project for the site's copy and photos (public, read-only; the dataset is public). Edit at
# https://packpass.sanity.studio. Unset VITE_SANITY_PROJECT_ID to build from src/content/defaults.ts only.
VITE_SANITY_PROJECT_ID=17ja5m2z
VITE_SANITY_DATASET=production
